# NetSurf Switch Framebuffer Configuration
override TARGET := framebuffer
CFLAGS += -fPIC
CXXFLAGS += -fPIC
override NETSURF_FB_FONTLIB := freetype
override NETSURF_USE_PNG := YES
override NETSURF_USE_BMP := YES
override NETSURF_USE_JPEG := YES
override NETSURF_USE_WEBP := NO
override NETSURF_USE_NSSVG := NO
override NETSURF_USE_RSVG := NO
override NETSURF_USE_DUKTAPE := YES
override NETSURF_USE_HARFBUZZ := YES
override NETSURF_LOG_LEVEL := DEBUG
override NETSURF_FB_RESPATH := romfs:/res:/switch/netsurf/res
override NETSURF_FB_FONTPATH := romfs:/fonts:/switch/netsurf/fonts
override NETSURF_FB_FONT_SANS_SERIF := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_SANS_SERIF_BOLD := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_SANS_SERIF_ITALIC_BOLD := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_SERIF := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_SERIF_BOLD := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_MONOSPACE := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_MONOSPACE_BOLD := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_CURSIVE := romfs:/res/sans_serif.ttf
override NETSURF_FB_FONT_FANTASY := romfs:/res/sans_serif.ttf
